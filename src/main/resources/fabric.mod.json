{
	"schemaVersion": 1,
	"id": "bactrian_brews",
	"version": "${version}",
	"name": "Bactrian Brews",
	"description": "This mod adds bactrian camel variants that are all tameable and rideable.",
	"authors": [
		"Tyton337"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "MIT",
	"icon": "assets/bactrian_brews/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.tyton.bactrian_brews.BactrianBrews"
		],
		"client": [
			"com.tyton.bactrian_brews.BactrianBrewsClient"
		],
		"fabric-datagen": [
			"com.tyton.bactrian_brews.BactrianBrewsDataGenerator"
		]
	},
	"mixins": [
		"bactrian_brews.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
